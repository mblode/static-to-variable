{
  "_expect": { "schema": false, "python": false },
  "version": 3,
  "id": "fixture-minimal",
  "family": {
    "name": "Fixture Family",
    "version": "1.000",
    "vendor": "FXTR",
    "designer": "Fixture Designer",
    "designerUrl": "https://example.com",
    "vendorUrl": "https://example.com"
  },
  "axes": [
    {
      "tag": "wght",
      "name": "Weight",
      "minimum": 100,
      "default": 400,
      "maximum": 900
    }
  ],
  "styles": {
    "roman": {
      "italic": false,
      "donors": [
        {
          "id": "regular",
          "name": "Fixture-Regular",
          "path": "donors/Fixture-Regular.ttf",
          "location": { "wght": 400 }
        },
        {
          "id": "black",
          "name": "Fixture-Black",
          "path": "donors/Fixture-Black.ttf",
          "location": { "wght": 900 }
        }
      ],
      "source": "build/fixture.glyphs",
      "masters": [
        {
          "name": "Regular",
          "donorId": "regular",
          "location": { "wght": 400 },
          "default": true
        },
        { "name": "Black", "donorId": "black", "location": { "wght": 900 } }
      ],
      "output": "build/fixture-vf.ttf"
    }
  },
  "output": {
    "dir": "build",
    "releaseDir": "build/release",
    "formats": ["ttf"],
    "hinting": "aggressive"
  }
}
